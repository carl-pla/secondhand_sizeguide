# .env.example - Kopiere diese Datei als '.env' und fülle die Werte aus

# --- Datenbank ---
# Der MongoDB Atlas Connection String (Public IP 0.0.0.0/0 in Atlas erlauben!)
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname

# --- E-Mail / Newsletter ---
# Deine Gmail-Adresse (für MAIL_FROM)
MAIL_FROM=deine.email@gmail.com
# Das 16-stellige Google App-Passwort (OHNE Leerzeichen!)
MAIL_PASSWORD=abcd efgh ijkl mnop

# --- KI / Ollama ---
# Für Docker-Nutzer (Option B): http://ollama:11434
# Für Docker-Nutzer mit lokalem Ollama auf dem Mac/PC (Option C): http://host.docker.internal:11434
# Für rein lokale Entwicklung ohne Docker: http://localhost:11434
OLLAMA_HOST=http://localhost:11434